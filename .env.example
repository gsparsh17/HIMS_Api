# Hospital backend only. Never place ABDM client/bridge credentials here.
NODE_ENV=development
APP_ROLE=HOSPITAL
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mediqliq_hospital
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
DISABLE_PERMISSION_CHECKS=false
ALLOW_PUBLIC_HOSPITAL_REGISTRATION=false

# MediQliq Master connector
ABDM_ENV=sandbox
ABDM_ENABLE_M1=true
ABDM_ENABLE_M2=true
ABDM_ENABLE_M3=true
ABDM_ENABLE_SUBSCRIPTIONS=false
ABDM_MASTER_URL=http://localhost:5004
ABDM_HFR_FACILITY_ID=INXXXXXXXXXX
ABDM_HIP_ID=INXXXXXXXXXX
ABDM_HIU_ID=INXXXXXXXXXX
ABDM_TENANT_CODE=MEDIQLIQ_SANDBOX
ABDM_CONNECTOR_KEY_ID=ROTATED_KEY_ID_FROM_MASTER
ABDM_CONNECTOR_SECRET=ROTATED_ONE_TIME_SECRET_FROM_MASTER
ABDM_CONNECTOR_TIMEOUT_MS=15000
ABDM_SHARED_SERVICE_TIMEOUT_MS=30000
ABDM_INTERNAL_REQUEST_MAX_AGE_MS=300000
ABDM_INTERNAL_REPLAY_TTL_SECONDS=600

# Encrypts ABHA user sessions, consent artefacts, imported FHIR and HIU private keys.
# Generate: openssl rand -hex 32
ABDM_HOSPITAL_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# M1 transaction and OTP controls
ABDM_OTP_RESEND_SECONDS=60
ABDM_OTP_MAX_ATTEMPTS=5
ABDM_IDENTITY_TRANSACTION_TTL_MINUTES=30
ABDM_SCAN_SHARE_TOKEN_EXPIRY_SECONDS=1800

# User-initiated M2 linking OTP
ABDM_LINK_OTP_TEST_MODE=true
ABDM_LINK_OTP_TEST_VALUE=123456
ABDM_SMS_PROVIDER_URL=
ABDM_SMS_PROVIDER_BEARER_TOKEN=
ABDM_SMS_TEMPLATE_ID=ABDM_LINK_OTP
ABDM_SMS_TIMEOUT_MS=10000

# FHIR validation. Structural validation always runs.
# master = MediQliq Master shared validator (recommended/default)
# local  = hospital-local deployment of the same reviewed validator image
# Optional FHIR fallback is safe because validation is stateless. It is disabled by default.
ABDM_FHIR_PROVIDER=master
ABDM_FHIR_FALLBACK_PROVIDER=none
ABDM_FHIR_IG_VERSION=6.5.0
ABDM_FHIR_VERSION=4.0.1
ABDM_FHIR_PACKAGE=ndhm.in#6.5.0
ABDM_FHIR_PACKAGE_CHECKSUM=
ABDM_FHIR_PROFILE_BASE=https://nrces.in/ndhm/fhir/r4/StructureDefinition
# Required only when ABDM_FHIR_PROVIDER=local or fallback=local.
ABDM_FHIR_VALIDATOR_URL=
ABDM_FHIR_VALIDATOR_MODE=hapi-wrapper
ABDM_FHIR_VALIDATOR_ALLOWED_HOSTS=
ABDM_FHIR_VALIDATOR_HEALTH_URL=
ABDM_FHIR_VALIDATOR_TIMEOUT_MS=30000
ABDM_FHIR_VALIDATOR_MAX_RESPONSE_BYTES=1048576
ABDM_REQUIRE_EXTERNAL_FHIR_VALIDATION=false

# Consent validation provider. No automatic cross-provider fallback is used because
# usage reservations are stateful and must be committed/released by their owning provider.
ABDM_CONSENT_PROVIDER=master
# The following local settings are required only when ABDM_CONSENT_PROVIDER=local.
ABDM_CONSENT_VALIDATOR_URL=
ABDM_CONSENT_VALIDATOR_ALLOWED_HOSTS=
ABDM_CONSENT_VALIDATOR_HEALTH_URL=
ABDM_CONSENT_VALIDATOR_TOKEN=
ABDM_CONSENT_VALIDATOR_TIMEOUT_MS=15000
ABDM_CONSENT_VALIDATOR_MAX_RESPONSE_BYTES=1048576
ABDM_REQUIRE_CONSENT_VALIDATION=false

# ABDM cryptography provider.
# master = MediQliq Master shared crypto (recommended/default)
# local  = hospital-local deployment of the same reviewed crypto image
# mock   = development only; forbidden in production
ABDM_CRYPTO_PROVIDER=master
ABDM_CRYPTO_ADAPTER_URL=
ABDM_CRYPTO_ADAPTER_TOKEN=
ABDM_CRYPTO_ADAPTER_ALLOWED_HOSTS=
ABDM_CRYPTO_ADAPTER_HEALTH_URL=
ABDM_CRYPTO_ADAPTER_TIMEOUT_MS=30000
ABDM_CRYPTO_ADAPTER_MAX_RESPONSE_BYTES=26214400
ABDM_REQUIRE_CRYPTO_INTEGRITY=true
ABDM_ALLOW_PRIVATE_ADAPTER_URLS=true

# Restrict all HIP -> HIU data-push destinations in production.
ABDM_DATA_PUSH_ALLOWED_HOSTS=
ABDM_ALLOW_PRIVATE_DATA_PUSH_URLS=true
ABDM_DATA_PUSH_TIMEOUT_MS=30000
ABDM_DATA_PUSH_PAGE_SIZE=50


# Hospital-local shared-service network. These are needed only for services whose
# provider is `local`. Never expose these service ports publicly.
ABDM_TRUSTED_INTERNAL_SERVICE_HOSTS=
ABDM_TRUSTED_INTERNAL_SERVICE_PORTS=3500,8090,8180,443
ABDM_INTERNAL_SERVICE_NETWORK_MODE=private-service-token
ABDM_INTERNAL_SERVICE_IDENTITY=ABDM_MASTER
ABDM_INTERNAL_SERVICE_AUTH_HEADER=X-MediQliq-Service-Token
ABDM_INTERNAL_SERVICE_AUTH_TOKEN=

# Hospital ABDM Packet Center. Every outbound care context is prepared as an
# immutable, encrypted, externally validated and approved packet version.
ABDM_PACKET_FEATURE_ENABLED=true
ABDM_PACKET_DEFAULT_REVIEW_POLICY=REQUIRED_BEFORE_TRANSFER
ABDM_PACKET_STORE_PLAINTEXT=false
ABDM_PACKET_RAW_FHIR_ROLES=admin,doctor
ABDM_PACKET_APPROVER_ROLES=admin,doctor
ABDM_PACKET_MAX_SOURCES=500
ABDM_PACKET_MAX_BUNDLE_BYTES=20971520
ABDM_DEPENDENCY_HEALTH_TTL_SECONDS=120
ABDM_HIU_PAGE_RETENTION_HOURS=24

# Hospital ABDM asynchronous jobs
ABDM_HOSPITAL_JOB_POLL_INTERVAL_MS=1000
ABDM_HOSPITAL_JOB_BATCH_SIZE=3
ABDM_HOSPITAL_JOB_MAX_ATTEMPTS=5
ABDM_HOSPITAL_JOB_STALE_MS=600000

# Existing HIMS integrations - configure only through a secret manager.
EMAIL_USER=
EMAIL_PASS=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
GEMINI_API_KEY=

# Optional paths for bilingual consent PDF rendering. Font files are not bundled.
DEVANAGARI_FONT_PATH=
DEVANAGARI_BOLD_FONT_PATH=
