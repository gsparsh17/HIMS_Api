[Unit]
Description=MediQliq HIMS Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediqliq
Group=mediqliq
WorkingDirectory=/opt/mediqliq/backend
EnvironmentFile=/etc/mediqliq/backend.env
ExecStart=/usr/bin/node /opt/mediqliq/backend/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/mediqliq/uploads /srv/mediqliq/tmp /opt/mediqliq/backend/backups
UMask=0027
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
