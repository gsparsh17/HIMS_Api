# ==============================================================
# MEDIQLIQ HIMS - WINDOWS LAN SERVER EXAMPLE
# Copy the relevant values into the SERVER backend .env.
# Do not copy secrets from this example; keep your existing MONGO_URI/JWT/etc.
# Windows paths use forward slashes intentionally because Node accepts them.
# ==============================================================

NODE_ENV=production
APP_ROLE=HOSPITAL
LAN_DEPLOYMENT_ENABLED=true
NODE_ROLE=SERVER
INSTANCE_ID=MEDIQLIQ-SERVER-01

# Listen on the LAN. Restrict port 5000 to the hospital LAN in Windows Firewall.
HOST=0.0.0.0
PORT=5000

# Keep your real frontend origin(s). Examples only:
FRONTEND_URL=http://192.168.1.52
CORS_ORIGINS=http://192.168.1.52

# Keep your existing secure values:
MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/hims?authSource=hims
JWT_SECRET=REPLACE_WITH_YOUR_EXISTING_STRONG_SECRET

# ==============================================================
# SHARED MEDIA STORAGE
# Physical directory: E:\MediQliqMedia
# SMB share may expose the same directory as \\192.168.1.52\MediQliqMedia,
# but the server backend should use its local E: path when it owns the disk.
# ==============================================================
HIMS_SHARED_STORAGE_ROOT=E:/MediQliqMedia
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PREFIX=media
UPLOAD_DIR=E:/MediQliqMedia
UPLOAD_TMP_DIR=E:/MediQliqMedia/temp

# ==============================================================
# SINGLE-NODE DAILY DATABASE BACKUP
# Only this server is allowed to run/trigger backups.
# Daily full backup is used by default because it does not require MongoDB
# Change Streams / a replica set.
# ==============================================================
BACKUP_ENABLED=true
BACKUP_NODE_ENABLED=true
BACKUP_SCHEDULER_ENABLED=true
BACKUP_STORAGE_PROVIDERS=local
BACKUP_REQUIRED_TARGETS=local
HIMS_BACKUP_DIR=E:/MediQliqMedia/backups
BACKUP_TIMEZONE=Asia/Kolkata

# Robust simple default: one complete DB backup every day at 02:00.
BACKUP_INCREMENTAL_ENABLED=false
BACKUP_FULL_ENABLED=true
BACKUP_FULL_CRON=0 2 * * *

# If the server was off at 02:00, run today's missing backup after startup.
BACKUP_STARTUP_CATCHUP_ENABLED=true
BACKUP_STARTUP_CATCHUP_TYPE=full
BACKUP_STARTUP_CATCHUP_AFTER=02:15
BACKUP_STARTUP_CATCHUP_DELAY_MS=5000

# Distributed lock: protects against accidental duplicate backup nodes.
BACKUP_COORDINATOR_LOCK_ENABLED=true
BACKUP_LOCK_LEASE_MS=1800000
BACKUP_LOCK_HEARTBEAT_MS=60000

# Keep the latest 30 daily full backups on this drive.
BACKUP_RETENTION_DAYS=30
BACKUP_LOCAL_RETENTION_DAYS=30
BACKUP_FULL_RETENTION_DAYS=30
ALLOW_BACKUP_RESTORE=false
