NODE_ENV=production
CONSENT_VALIDATOR_ENV=production
PORT=8180
HOST=0.0.0.0

CONSENT_VALIDATOR_MONGO_URI=mongodb://consent-validator:REPLACE@mongodb.internal:27017/mediqliq_consent_validator?authSource=admin&replicaSet=rs0
CONSENT_VALIDATOR_SERVICE_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
CONSENT_VALIDATOR_IDENTIFIER_PEPPER=REPLACE_WITH_RANDOM_HASH_PEPPER

# Use the current, written ABDM/NHA trust endpoint or pin an approved JWKS.
CONSENT_VALIDATOR_JWKS_URL=https://REPLACE_WITH_APPROVED_HOST/.well-known/jwks.json
CONSENT_VALIDATOR_JWKS_ALLOWED_HOSTS=REPLACE_WITH_APPROVED_HOST
CONSENT_VALIDATOR_PINNED_JWKS_JSON=
CONSENT_VALIDATOR_EXPECTED_ISSUERS=REPLACE_WITH_APPROVED_ISSUER
CONSENT_VALIDATOR_EXPECTED_AUDIENCES=REPLACE_WITH_MEDIQLIQ_HIP_OR_HIU_AUDIENCE
CONSENT_VALIDATOR_ALLOWED_ALGORITHMS=RS256,RS512,ES256
CONSENT_VALIDATOR_CLOCK_SKEW_SECONDS=120
CONSENT_VALIDATOR_JWKS_CACHE_SECONDS=3600

CONSENT_VALIDATOR_FREQUENCY_OPERATIONS=HIP_DISCLOSURE,HIU_DATA_REQUEST
CONSENT_VALIDATOR_FREQUENCY_REPEATS_MODE=ADDITIONAL
CONSENT_VALIDATOR_RESERVATION_TTL_SECONDS=900
CONSENT_VALIDATOR_DECISION_TTL_SECONDS=300
CONSENT_VALIDATOR_MAX_RETENTION_DAYS=3650
CONSENT_VALIDATOR_REQUIRE_MONGO_TRANSACTIONS=true
CONSENT_VALIDATOR_ALLOW_UNSIGNED_SANDBOX_ARTEFACTS=false

CONSENT_VALIDATOR_BODY_LIMIT=2mb
CONSENT_VALIDATOR_RATE_LIMIT_WINDOW_MS=60000
CONSENT_VALIDATOR_RATE_LIMIT_MAX=300
CONSENT_VALIDATOR_TRUST_FETCH_TIMEOUT_MS=5000
