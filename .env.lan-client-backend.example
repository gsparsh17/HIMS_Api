# ==============================================================
# MEDIQLIQ HIMS - ELECTRON/CLIENT BACKEND EXAMPLE
# Use this ONLY if each Electron workstation actually starts its own Node backend.
# Preferred architecture is still for Electron clients to call the central server API.
# ==============================================================

NODE_ENV=production
APP_ROLE=HOSPITAL
LAN_DEPLOYMENT_ENABLED=true
NODE_ROLE=CLIENT
INSTANCE_ID=MEDIQLIQ-CLIENT-RECEPTION-01

# A client-local backend normally binds only to that workstation.
HOST=127.0.0.1
PORT=5000

# All workstation backends may connect to the same central MongoDB if that is
# your current deployment architecture. Keep the real credentials private.
MONGO_URI=mongodb://USER:PASSWORD@192.168.1.52:27017/hims?authSource=hims
JWT_SECRET=REPLACE_WITH_THE_SAME_SECURE_DEPLOYMENT_SECRET_IF_REQUIRED_BY_YOUR_ARCHITECTURE

# If client-local backends process uploads, point permanent media to the SMB share.
# The Windows account running Electron/Node must have read/write permission.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_PREFIX=media
UPLOAD_DIR=//192.168.1.52/MediQliqMedia
# Prefer a local temp folder for workstation upload staging.
UPLOAD_TMP_DIR=C:/MediQliqTemp

# CRITICAL: workstation backends never schedule or manually execute DB backups.
BACKUP_ENABLED=false
BACKUP_NODE_ENABLED=false
BACKUP_SCHEDULER_ENABLED=false
BACKUP_COORDINATOR_LOCK_ENABLED=true

# No HIMS_BACKUP_DIR is required on a non-backup node.
ALLOW_BACKUP_RESTORE=false
